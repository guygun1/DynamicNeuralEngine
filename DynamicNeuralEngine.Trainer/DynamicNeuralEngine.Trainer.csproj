<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseAppHost>false</UseAppHost>
    <NativeLibraryPath Condition="'$(NativeLibraryPath)' == ''">$(MSBuildProjectDirectory)\..\cmake-build-debug\native\DynamicNeuralEngine.dll</NativeLibraryPath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebUI\index.html;WebUI\app.css;WebUI\app.js" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Update="TeachingMaterials\**\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyCppDll" AfterTargets="Build">
    <Error Condition="!Exists('$(NativeLibraryPath)')" Text="Build the native engine first: cmake --build cmake-build-debug. For a different build directory, set -p:NativeLibraryPath=full-path-to-DynamicNeuralEngine.dll." />
    <Copy SourceFiles="$(NativeLibraryPath)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
